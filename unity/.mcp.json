{
  "mcpServers": {
    "unity-mcp": {
      "command": "unity",
      "args": ["mcp", "--project-path", "."]
    },
    "blender": {
      "command": "uv",
      "args": ["--directory", "${BLENDER_MCP_DIR:-C:/blender_mcp/mcp}", "run", "blender-mcp"],
      "env": {
        "BLENDER_MCP_HOST": "${BLENDER_MCP_HOST:-localhost}",
        "BLENDER_MCP_PORT": "${BLENDER_MCP_PORT:-9876}"
      }
    }
  }
}
